__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Leading slashes matter: unanchored "data/" would also ignore the
# src/nexa/data package, and "models/" any nested models package.
/build/
/dist/
/data/
/demo-data/
/backups/
/logs/
/models/

*.db
*.db-wal
*.db-shm

# Generated at runtime, never committed.
/chroma_db/
/.coverage

# Gmail OAuth client secrets and any exported token material (Section 38).
# Tokens live in Windows Credential Manager; this is only the client file.
gmail_client_secret.json
client_secret*.json
*token.json
